---
layout: base.njk
---
<article class="journal-article">
  <header class="article-header">
    <div class="narrow-shell">
      <a class="back-link" href="/journal/">← Back to the journal</a>
      {% if placeholder %}
        <p class="placeholder-badge">Example article · copy to be replaced</p>
      {% endif %}
      <p class="eyebrow">{{ category or "From the workbench" }}</p>
      <h1>{{ title }}</h1>
      <p class="article-deck">{{ description }}</p>
      <p class="article-meta">{{ displayDate }}{% if author %} · {{ author }}{% endif %}</p>
    </div>
  </header>
  {% if image %}
    <div class="article-image shell">
      <img src="{{ image }}" alt="{{ imageAlt or title }}" />
    </div>
  {% endif %}
  <div class="prose narrow-shell">
    {{ content | safe }}
  </div>
</article>
