---
layout: base.njk
navKey: Home
---
<section class="hero">
  <img class="hero-image" src="{{ site.hero.image }}" alt="A colourful display of sewn goods and turned wooden pieces" />
  <div class="hero-shade"></div>
  <div class="hero-content shell">
    <p class="eyebrow eyebrow--light">{{ site.hero.eyebrow }}</p>
    <h1>{{ site.hero.title }}</h1>
    <p class="hero-intro">{{ site.hero.intro }}</p>
    <div class="button-row">
      <a class="button button--pink" href="{{ site.hero.primaryAction.url }}">{{ site.hero.primaryAction.label }}</a>
      <a class="button button--ghost" href="{{ site.hero.secondaryAction.url }}">{{ site.hero.secondaryAction.label }}</a>
    </div>
  </div>
  <p class="hero-caption">{{ site.location }} · Sewn &amp; turned by hand</p>
</section>

<section class="intro-section section">
  <div class="shell intro-grid">
    <div>
      <p class="eyebrow">{{ site.introduction.eyebrow }}</p>
      <h2>{{ site.introduction.title }}</h2>
    </div>
    <div class="intro-copy">
      <p>{{ site.introduction.body }}</p>
    </div>
  </div>
</section>

<section class="makers-section">
  <div class="shell">
    <div class="section-heading section-heading--split">
      <div>
        <p class="eyebrow">Meet the makers</p>
        <h2>Bits and Bobyns and The Yorkshire Garage.</h2>
      </div>
      <a class="text-link" href="/makers/">Meet both makers <span aria-hidden="true">→</span></a>
    </div>

    <div class="maker-panels">
      {% for brand in site.brands %}
        <article class="maker-panel maker-panel--{{ brand.panelTone }}">
          <div class="maker-panel-image">
            <img src="{{ brand.image }}" alt="{{ brand.name }} work on the Sticks and Giggles display" />
          </div>
          <div class="maker-panel-copy">
            <p class="eyebrow">{{ brand.kicker }}</p>
            <h3>{{ brand.name }}</h3>
            <p>{{ brand.description }}</p>
            <a class="text-link" href="{{ brand.url }}" target="_blank" rel="noopener noreferrer">{{ brand.buttonLabel }} <span aria-hidden="true">↗</span></a>
          </div>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

<section class="featured-section section" id="featured-work">
  <div class="shell">
    <div class="section-heading section-heading--split">
      <div>
        <p class="eyebrow">Featured work</p>
        <h2>A few things we've made.</h2>
      </div>
      <p class="section-summary">The stock changes as we make new pieces.</p>
    </div>

    <div class="work-grid">
      {% for work in site.featuredWork %}
        <article class="work-card work-card--{{ work.tone }} work-card--{{ work.size }}">
          <div class="work-card-image">
            <img src="{{ work.image }}" alt="{{ work.title }} by {{ work.category }}" loading="lazy" />
          </div>
          <div class="work-card-caption">
            <p>{{ work.category }}</p>
            <h3>{{ work.title }}</h3>
          </div>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

<section class="next-show-section section">
  <div class="shell">
    <div class="section-heading section-heading--split section-heading--light">
      <div>
        <p class="eyebrow eyebrow--light">Upcoming shows</p>
        <h2>Where we'll be next.</h2>
      </div>
      <a class="text-link text-link--light" href="/shows/">All show details <span aria-hidden="true">→</span></a>
    </div>

    {% if site.shows and site.shows.length %}
      {% set nextShow = site.shows[0] %}
      <article class="event-feature">
        <div class="event-date-block">
          <strong>{{ nextShow.dateShort }}</strong>
          <span>{{ nextShow.year }}</span>
        </div>
        <div class="event-feature-copy">
          <p>{{ nextShow.location }}</p>
          <h3>{{ nextShow.name }}</h3>
          {% if nextShow.note %}<p class="event-note">{{ nextShow.note }}</p>{% endif %}
        </div>
        <a class="button button--cream" href="{{ nextShow.url }}" target="_blank" rel="noopener noreferrer">{{ nextShow.buttonLabel }}</a>
      </article>
    {% else %}
      <p class="empty-state">We haven't got another date in the diary yet. Check back soon.</p>
    {% endif %}
  </div>
</section>

{% if gallery and gallery.length %}
  {% set featuredGallery = gallery[0] %}
  <section class="story-section section">
    <div class="shell story-grid">
      <div class="story-image-stack">
        <img class="story-image-main" src="{{ featuredGallery.cover }}" alt="{{ featuredGallery.title }}" loading="lazy" />
        {% if featuredGallery.images[2] %}
          <img class="story-image-small" src="{{ featuredGallery.images[2].src }}" alt="{{ featuredGallery.images[2].alt }}" loading="lazy" />
        {% endif %}
      </div>
      <div class="story-copy">
        <p class="eyebrow">{{ featuredGallery.type }}</p>
        <h2>{{ featuredGallery.title }}</h2>
        <p>{{ featuredGallery.summary }}</p>
        <p class="story-meta">{{ featuredGallery.date }} · {{ featuredGallery.location }}</p>
        <a class="button button--dark" href="/gallery/">View the gallery</a>
      </div>
    </div>
  </section>
{% endif %}

{% for post in collections.journal | reverse %}
  {% if loop.first %}
    <section class="home-journal section">
      <div class="shell home-journal-grid">
        <a class="home-journal-image" href="{{ post.url }}">
          <img src="{{ post.data.image }}" alt="{{ post.data.imageAlt or post.data.title }}" loading="lazy" />
        </a>
        <div class="home-journal-copy">
          {% if post.data.placeholder %}<p class="placeholder-badge">Example article</p>{% endif %}
          <p class="eyebrow">{{ post.data.category }}</p>
          <h2>{{ post.data.title }}</h2>
          <p>{{ post.data.description }}</p>
          <a class="button button--dark" href="{{ post.url }}">Read from the journal</a>
        </div>
      </div>
    </section>
  {% endif %}
{% endfor %}

<section class="social-section section">
  <div class="shell">
    <div class="section-heading section-heading--split">
      <div>
        <p class="eyebrow">Instagram</p>
        <h2>Follow Sticks &amp; Giggles or either maker.</h2>
      </div>
    </div>
    <div class="social-grid">
      {% for social in site.socials %}
        <a class="social-card social-card--{{ social.tone }}" href="{{ social.url }}" target="_blank" rel="noopener noreferrer">
          <span class="social-platform">Instagram</span>
          <h3>{{ social.label }}</h3>
          <strong>{{ social.handle }}</strong>
          <p>{{ social.description }}</p>
          <span class="social-arrow" aria-hidden="true">↗</span>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

<section class="contact-band">
  <div class="shell contact-band-inner">
    <div>
      <p class="eyebrow">Market and event enquiries</p>
      <h2>Would you like us at your event?</h2>
    </div>
    <a class="button button--dark" href="mailto:{{ site.email }}">Email {{ site.email }}</a>
  </div>
</section>
