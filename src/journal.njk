---
layout: base.njk
title: Journal
navKey: Journal
description: Notes from the workbenches and market stall at Sticks & Giggles.
permalink: /journal/index.html
---
<header class="page-hero page-hero--cream">
  <div class="shell">
    <p class="eyebrow">Journal</p>
    <h1>Notes from the<br />workbenches.</h1>
    <p>Short updates about what we're making and how we're preparing for markets.</p>
  </div>
</header>

<section class="journal-index section">
  <div class="shell">
    <div class="journal-grid">
      {% for post in collections.journal | reverse %}
        <article class="journal-card">
          <a class="journal-card-image" href="{{ post.url }}">
            <img src="{{ post.data.image }}" alt="{{ post.data.imageAlt or post.data.title }}" loading="lazy" />
          </a>
          <div class="journal-card-copy">
            {% if post.data.placeholder %}<p class="placeholder-badge">Example article</p>{% endif %}
            <p class="eyebrow">{{ post.data.category }}</p>
            <h2><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
            <p>{{ post.data.description }}</p>
            <a class="text-link" href="{{ post.url }}">Read the story <span aria-hidden="true">→</span></a>
          </div>
        </article>
      {% else %}
        <p class="empty-state empty-state--light">Stories are currently being made.</p>
      {% endfor %}
    </div>
  </div>
</section>
